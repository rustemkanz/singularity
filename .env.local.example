# Repo-local defaults for this helper.
# Copy to .env.local and fill in the values for your project and team.
# Shell-exported values still win over values in this file.

AZURE_DEVOPS_ORG="example-org"
AZURE_DEVOPS_PROJECT="Example Project"
AZURE_DEVOPS_TEAM_ID="00000000-0000-0000-0000-000000000000"
AZURE_DEVOPS_USER="your.name@example.com"
AZURE_DEVOPS_QA_USER="qa@example.com"

# To discover the team GUID for AZURE_DEVOPS_TEAM_ID, run:
# ./sg teams

# Optional overrides
# AZURE_DEVOPS_DEFAULT_REPO="example-repo"
# AZURE_DEVOPS_API_VERSION="7.1"
# AZURE_DEVOPS_RESOURCE="499b84ac-1321-427f-aa17-267ca6975798"
# GITLAB_TOKEN="glpat-..."
# GITLAB_BASE_URL="https://gitlab.com"
